# deploy.sh copies this to the repo root on the VPS as `.env` with fresh secrets (never commit the real one).
APP_NAME=FileNest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://files.azoclinic.duckdns.org
# Office editor (ONLYOFFICE): the secret is generated by deploy.sh on first run.
ONLYOFFICE_JWT_SECRET=
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=filenest
DB_USERNAME=filenest
DB_PASSWORD=
# Used only by the MySQL container on first start.
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Thumbnails, text extraction and video transcoding run in the `queue` container.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@azoclinic.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"

FILENEST_CHUNK_SIZE_MB=20
FILENEST_MAX_UPLOAD_MB=4096

VITE_APP_NAME="${APP_NAME}"
