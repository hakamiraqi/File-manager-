APP_NAME=ExamNest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3309
DB_DATABASE=examnest
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=10080
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log


# The offline edition: works only once activated with an exam-system code from the licensing portal.
OFFLINE_EDITION=true
OFFLINE_ACTIVATION=true
OFFLINE_LICENSE_SERVER=https://dental.azoclinic.duckdns.org
